# Google Sheets
# Accepts inline service account JSON or a path to a JSON file.
INFRA_LABS_GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
INFRA_LABS_SPREADSHEET_ID=your-spreadsheet-id-here
INFRA_LABS_WORKSHEET_NAME=Sheet1

# OpenStack
INFRA_LABS_OPENSTACK_CLOUD=default
INFRA_LABS_OPENSTACK_DOMAIN_ID=your-domain-id
INFRA_LABS_OPENSTACK_MEMBER_ROLE=member
INFRA_LABS_OPENSTACK_LB_ROLE=load-balancer_member

# Resend Email
INFRA_LABS_RESEND_API_KEY=re_your_api_key_here
INFRA_LABS_RESEND_FROM_EMAIL=infra-labs@your-domain.com
# Receives deletion previews (comma-separated for several admins). If unset,
# previews are skipped and ready_to_delete rows are never deleted.
INFRA_LABS_ADMIN_EMAIL=admin@your-domain.com

# Behavior
INFRA_LABS_EXPIRY_WARNING_DAYS=14
INFRA_LABS_GRACE_PERIOD_DAYS=7
INFRA_LABS_DRY_RUN=false
INFRA_LABS_LOG_LEVEL=INFO

# Ceph RadosGW (optional — enables object storage bucket inventory and deletion)
# The admin key-pair must have caps: buckets=*;users=*
# INFRA_LABS_RGW_ADMIN_URL=https://rgw.example.com
# INFRA_LABS_RGW_ADMIN_ACCESS_KEY=
# INFRA_LABS_RGW_ADMIN_SECRET_KEY=
# INFRA_LABS_RGW_ADMIN_REGION=

# node_exporter textfile directory for the success metric (optional; skipped
# when the directory does not exist)
# INFRA_LABS_TEXTFILE_COLLECTOR_DIR=/var/lib/node_exporter/textfile_collector
